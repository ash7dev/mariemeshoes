# Application : pooler Supabase en mode TRANSACTION (port 6543), adapté à Vercel (serverless).
DATABASE_URL="postgresql://postgres.xxx:your-password@aws-1-eu-west-1.pooler.supabase.com:6543/postgres"

# CLI Prisma (migrations, studio) : pooler en mode SESSION (port 5432), compatible IPv4.
DIRECT_URL="postgresql://postgres.xxx:your-password@aws-1-eu-west-1.pooler.supabase.com:5432/postgres"

# Base « shadow » pour `npm run db:migrate` (second projet Supabase, JAMAIS la production)
SHADOW_DATABASE_URL=""

# Supabase (clé publique uniquement)
NEXT_PUBLIC_SUPABASE_URL="https://your-project.supabase.co"
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY="sb_publishable_..."

# Clé SECRÈTE (contourne la RLS) : serveur uniquement, JAMAIS préfixée NEXT_PUBLIC_
SUPABASE_SECRET_KEY="sb_secret_..."
SUPABASE_JWKS_URL="https://your-project.supabase.co/auth/v1/.well-known/jwks.json"

# Application
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Boutique (vides = boutons masqués)
NEXT_PUBLIC_WHATSAPP_PHONE=""      # E.164, ex. +221771234567
NEXT_PUBLIC_INSTAGRAM_URL=""
NEXT_PUBLIC_TIKTOK_URL=""
